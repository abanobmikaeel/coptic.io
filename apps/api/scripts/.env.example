# OpenAI-compatible chat completions endpoint for daily-verse selection.
# Copy to .env and fill in.

# DeepSeek (default):
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# Or a local ollama server (no key required):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# (omit LLM_API_KEY)

# Optional batching tuning:
# LLM_BATCH_SIZE=5
# LLM_BATCH_DELAY_MS=1000
